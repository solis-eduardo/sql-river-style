{
  "name": "sql-river-style",
  "displayName": "SQL River Style",
  "description": "Opinionated SQL formatter with right-aligned (\"river style\") keywords, one column per line, and structured CTEs/JOINs/CASE blocks.",
  "version": "1.2.1",
  "publisher": "EduardoBraun",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/solis-eduardo/sql-river-style.git"
  },
  "bugs": {
    "url": "https://github.com/solis-eduardo/sql-river-style/issues"
  },
  "homepage": "https://github.com/solis-eduardo/sql-river-style#readme",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0b3d5c",
    "theme": "dark"
  },
  "keywords": [
    "sql",
    "postgresql",
    "formatter",
    "river style",
    "pretty print"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:sql"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sqlRiverStyle.format",
        "title": "SQL River Style: Format Document"
      }
    ],
    "configuration": {
      "title": "SQL River Style",
      "properties": {
        "sqlRiverStyle.indentSize": {
          "type": "number",
          "default": 4,
          "description": "Number of spaces used to indent CTE bodies and derived-table subqueries in FROM/JOIN."
        },
        "sqlRiverStyle.additionalFunctions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra native function names (besides the built-in list) to uppercase when formatting."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/examples.js",
    "smoke": "node ./out/test/smoke.js",
    "generate-examples": "npm run compile && node ./out/test/generate-examples.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
